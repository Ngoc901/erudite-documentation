        <mxCell id="16" value="Validate fields (title, body, points &gt; 0, etc.)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="110" y="560" width="200" height="50" as="geometry"/>
