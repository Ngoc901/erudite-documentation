        </mxCell>
        <mxCell id="7" value="Click &quot;Add Challenge&quot;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="110" y="170" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="Select challenge type (quiz / text / code)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="110" y="230" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="9" value="Display creation form for selected type" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="110" y="230" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="Fill in challenge details (title, body, difficulty, points, correct answer, options, etc.)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="100" y="310" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Click &quot;Create&quot;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
