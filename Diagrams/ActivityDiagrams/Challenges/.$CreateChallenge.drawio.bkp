        <mxCell id="17" value="Validation errors?" style="rhombus;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="120" y="640" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="Return HTTP 400 / Show field errors" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="320" y="653" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="Correct fields" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="110" y="653" width="200" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="Type = quiz or text?" style="rhombus;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="110" y="730" width="200" height="60" as="geometry"/>
