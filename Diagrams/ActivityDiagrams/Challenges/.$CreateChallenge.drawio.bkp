        </mxCell>

        <mxCell id="13" value="User is owner?" style="rhombus;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="120" y="470" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="Return HTTP 403" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
          <mxGeometry x="320" y="483" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="" style="ellipse;aspect=fixed;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="190" y="483" width="30" height="30" as="geometry"/>
