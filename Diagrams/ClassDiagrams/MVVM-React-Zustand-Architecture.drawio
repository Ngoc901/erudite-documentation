        <mxCell id="card_view_layer" parent="1" style="rounded=2;fillColor=#1A1A5E;strokeColor=#4F46E5;fontColor=#F1F5F9;fontSize=12;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;📄  VIEW&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#CBD5E1&quot; style=&quot;font-size: 17px;&quot;&gt;Pages &amp;amp; Components (React JSX)&lt;br&gt;· Renders UI from props / state&lt;br&gt;· Fires events on user interaction&lt;br&gt;· Subscribes to ViewModel (hooks)&lt;br&gt;· No direct API calls&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="80" y="887" as="geometry" />
        </mxCell>
        <mxCell id="card_vm_layer" parent="1" style="rounded=2;fillColor=#14532D;strokeColor=#16A34A;fontColor=#F1F5F9;fontSize=12;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;🪝  VIEWMODEL&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#CBD5E1&quot; style=&quot;font-size: 17px;&quot;&gt;Custom Hooks + Zustand Stores&lt;br&gt;· Orchestrates API calls&lt;br&gt;· Manages loading / error / data&lt;br&gt;· Exposes clean interface to View&lt;br&gt;· Stores persist global state&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="420" y="887" as="geometry" />
        </mxCell>
        <mxCell id="card_model_layer" parent="1" style="rounded=2;fillColor=#3B0764;strokeColor=#9333EA;fontColor=#F1F5F9;fontSize=12;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;📡  MODEL&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#CBD5E1&quot; style=&quot;font-size: 17px;&quot;&gt;API Client + Endpoints&lt;br&gt;· Wraps axios with interceptors&lt;br&gt;· Injects JWT auth headers&lt;br&gt;· Handles token refresh (401)&lt;br&gt;· Returns typed response data&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="760" y="887" as="geometry" />
        </mxCell>
        <mxCell id="card_zustand" parent="1" style="rounded=2;fillColor=#78350F;strokeColor=#D97706;fontColor=#F1F5F9;fontSize=12;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;🗂️  ZUSTAND&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#CBD5E1&quot; style=&quot;font-size: 17px;&quot;&gt;authStore · colorModeStore&lt;br&gt;· Replaces Redux boilerplate&lt;br&gt;· Minimal API: create() + set()&lt;br&gt;· Components subscribe directly&lt;br&gt;· Persists to localStorage&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="1100" y="887" as="geometry" />
        </mxCell>
