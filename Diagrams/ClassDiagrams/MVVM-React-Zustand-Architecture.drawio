        <mxCell id="summary_title" parent="1" style="text;html=1;fillColor=none;strokeColor=none;align=center;fontSize=15;fontStyle=1;fontColor=#F1F5F9;" value="MVVM Pattern - Component Responsibilities" vertex="1">
