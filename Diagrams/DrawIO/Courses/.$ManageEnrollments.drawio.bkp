        </mxCell>
        <mxCell id="13" value="Click &quot;Enroll&quot;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="30" y="520" width="170" height="40" as="geometry"/>
        </mxCell>

        <!-- System: check student exists -->
        <mxCell id="14" value="Student exists?" style="rhombus;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
