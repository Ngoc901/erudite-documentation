        </mxCell>
        <mxCell id="24" value="Click &quot;Remove&quot; next to student" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="3">
          <mxGeometry x="220" y="460" width="170" height="40" as="geometry"/>
        </mxCell>

        <!-- System: Delete enrollment -->
        <mxCell id="25" value="Delete CourseEnrollment record DELETE /api/.../students/&lt;username&gt;/" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="4">
